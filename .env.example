# =============================================================================
# Amharic Song Lyrics API - environment variables
# =============================================================================
# Local development:
#   cp .env.example .env   (then fill in the values)
#
# Render:
#   Dashboard -> your web service -> Environment -> add the same keys.
#   If you deploy with the Blueprint (render.yaml), Render prompts for every
#   key marked `sync: false` and generates the JWT secrets automatically.
#
# Never commit the real `.env` file; it contains database credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# `production` serves the built frontend from dist/ and disables the Vite dev
# server. Render sets this automatically (see render.yaml).
NODE_ENV=production

# Render assigns PORT (10000 in render.yaml). Use 3000 locally.
PORT=3000

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# Preferred and used by both the runtime (Drizzle/pg) and Prisma migrations.
# On Render, copy the **Internal Database URL** from:
#   Postgres instance -> Connect -> Internal Database URL
# (Use the internal URL when the web service and database are in the same
# region; it is faster and keeps traffic on Render's private network.)
#
# Internal URL: postgresql://USER:PASSWORD@INTERNAL_HOST:5432/DATABASE
# External URL: postgresql://USER:PASSWORD@EXTERNAL_HOST:5432/DATABASE?sslmode=require
#
# The external URL (local machine / CI / external tools) MUST include
# `?sslmode=require`, otherwise Render rejects the connection.
# Example placeholders only - replace with the real values from Render:
DATABASE_URL=postgresql://USER:PASSWORD@INTERNAL_HOST:5432/DATABASE

# -----------------------------------------------------------------------------
# Authentication / JWT (required)
# -----------------------------------------------------------------------------
# Generate 32+ byte secrets, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# render.yaml lets Render generate these automatically.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# -----------------------------------------------------------------------------
# Public URLs / CORS
# -----------------------------------------------------------------------------
# Public URL of this web service, including the scheme.
APP_URL=https://your-service-name.onrender.com

# Comma-separated list of browser origins allowed to call the API.
# Include APP_URL itself when this service also serves the frontend.
CORS_ORIGIN=https://your-service-name.onrender.com

# -----------------------------------------------------------------------------
# Admin bootstrap and Google sign-in (optional)
# -----------------------------------------------------------------------------
# Google OAuth client ID. Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=

# The account that signs up with this email is promoted to ADMIN.
ADMIN_EMAIL=

# Enables first-run password bootstrap for the admin account.
# Must be at least 32 characters. Leave blank to disable it.
ADMIN_PASSCODE=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# =============================================================================
# Optional: local Postgres / Docker Compose only
# =============================================================================
# These discrete variables are used only when DATABASE_URL is empty or is a
# placeholder (for example, the local docker-compose database).
# They are NOT needed on Render when DATABASE_URL is set.
SQL_HOST=localhost
SQL_USER=amharic_user
SQL_PASSWORD=change_me_in_production
SQL_DB_NAME=amharic_lyrics
# Set to true only if your local Postgres requires TLS.
SQL_SSL=false

# Used only by drizzle-kit (src/db/drizzle.config.ts) for local schema pushes.
# Not needed on Render, where Prisma migrations are used.
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

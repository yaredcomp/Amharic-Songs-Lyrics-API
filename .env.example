# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Required for Docker Compose and production deployments.
SQL_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional server configuration
PORT=3000
CORS_ORIGIN=
ADMIN_EMAIL=

# Required to enable first-run password-based admin bootstrap.
# Generate a unique random secret with at least 32 characters.
ADMIN_PASSCODE=
